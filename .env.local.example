# ===============================================================
# Firebase Configuration
# Ganti dengan kredensial dari project Firebase Anda di file .env.local
# Anda bisa mendapatkannya dari Firebase Console > Project Settings.
# JANGAN SIMPAN KUNCI ASLI DI FILE INI.
# ===============================================================
VITE_FIREBASE_API_KEY="GANTI_DENGAN_API_KEY_ANDA"
VITE_FIREBASE_AUTH_DOMAIN="GANTI_DENGAN_AUTH_DOMAIN_ANDA"
VITE_FIREBASE_PROJECT_ID="GANTI_DENGAN_PROJECT_ID_ANDA"
VITE_FIREBASE_STORAGE_BUCKET="GANTI_DENGAN_STORAGE_BUCKET_ANDA"
VITE_FIREBASE_MESSAGING_SENDER_ID="GANTI_DENGAN_MESSAGING_SENDER_ID_ANDA"
VITE_FIREBASE_APP_ID="GANTI_DENGAN_APP_ID_ANDA"
VITE_FIREBASE_MEASUREMENT_ID="GANTI_DENGAN_MEASUREMENT_ID_ANDA"

# ===============================================================
# Cloudinary Configuration
# Kredensial untuk upload gambar.
# ===============================================================
VITE_CLOUDINARY_CLOUD_NAME="dq5rlg1sz"
VITE_CLOUDINARY_UPLOAD_PRESET="app ewaste"